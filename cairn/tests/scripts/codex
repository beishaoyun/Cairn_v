#!/usr/bin/env python3
"""Fake `codex` CLI for test_worker_drivers — no real LLM.

New sessions emit `session id: <uuid>` to stderr (RegexSessionDriver contract,
v1 §8.4); `codex exec resume <sid>` prints the resumed reply; `--help` exits 0.
"""
import sys
import uuid


def main(argv):
    if "--help" in argv or "-h" in argv or not argv:
        print("usage: codex exec [--model M] [-c K=V] PROMPT | codex exec resume SID [PROMPT]")
        return 0
    if argv[0] == "exec":
        rest = argv[1:]
        if rest and rest[0] == "resume":
            print("fake-codex: resumed session")
            return 0
        print(f"session id: {uuid.uuid4()}", file=sys.stderr)
        print("fake-codex: acknowledged prompt")
        return 0
    print("fake-codex: unknown invocation", file=sys.stderr)
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
