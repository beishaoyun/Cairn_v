#!/usr/bin/env python3
"""Fake `pi` CLI for test_worker_drivers — no real LLM.

Emits stdout JSONL events like a real `pi --json`: a `type:session` event carrying the
session id, then `turn_end` with the last assistant text. `--help` exits 0.
"""
import json
import sys
import uuid


def main(argv):
    if "--help" in argv or "-h" in argv or not argv:
        print("usage: pi [--session-dir D] [--session-id S] PROMPT")
        return 0
    sid = str(uuid.uuid4())
    print(json.dumps({"type": "session", "session_id": sid}), flush=True)
    print(json.dumps({"type": "turn_start"}), flush=True)
    print(json.dumps({"type": "turn_end", "text": "fake-pi: acknowledged prompt"}), flush=True)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
