#!/usr/bin/env python3
"""Fake `claude` CLI for test_worker_drivers — no real LLM.

Emulates the claude-code `-p` / `-r` print-mode contract: the assistant reply goes to
stdout, `--help` exits 0 (health probe, graph §4-26).
"""
import sys


def main(argv):
    if "--help" in argv or "-h" in argv or not argv:
        print("usage: claude [--session-id S] [-r S] -p [--] PROMPT")
        return 0
    print("fake-claude: acknowledged prompt")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
